<!DOCTYPE html>
<html lang="tr">
<head>
  <link rel="icon" type="image/png" href="/nimes.png">
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Nimes - Earth SMP</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
  <style>
    :root {
      --glass:         rgba(255,255,255,0.13);
      --glass-border:  rgba(255,255,255,0.28);
      --glass-blur:    blur(22px) saturate(1.6);
      --glass-shadow:  0 8px 40px rgba(0,0,0,0.22), inset 0 1px 0 rgba(255,255,255,0.35), inset 0 0 0 1px rgba(255,255,255,0.12);
      --liquid-bg:     rgba(255,255,255,0.16);
      --liquid-border: rgba(255,255,255,0.50);
      --liquid-shadow: 0 6px 20px rgba(100,160,255,0.18), inset 0 2px 8px rgba(255,255,255,0.70), inset 0 -2px 4px rgba(0,0,0,0.10);
      --accent:        #7eb8ff;
      --text:          #ffffff;
      --text-dim:      rgba(255,255,255,0.65);
      --sidebar-w:     240px;
    }

    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    html { scroll-behavior: smooth; }

    body {
      font-family: 'Outfit', sans-serif;
      min-height: 100vh;
      background: #000000;
      color: var(--text);
      overflow-x: hidden;
    }

    /* ============================================================ */
    /*  APP LAYOUT                                                   */
    /* ============================================================ */
    .app-layout {
      display: flex;
      min-height: 100vh;
      position: relative;
      z-index: 1;
    }

    /* ============================================================ */
    /*  LEFT SIDEBAR — Fixed always                                  */
    /* ============================================================ */
    .sidebar {
      position: fixed;
      top: 0;
      left: 0;
      width: var(--sidebar-w);
      height: 100vh;
      display: flex;
      flex-direction: column;
      padding: 0px 16px 20px;
      gap: 0;
      z-index: 100;
      background: transparent;
    }

    .sidebar-logo {
      font-size: 24px;
      font-weight: 900;
      letter-spacing: -0.5px;
      color: #fff;
      padding: 0 4px 0;
      margin-bottom: 12px;
      display: flex;
      align-items: flex-end;
      min-height: 80px;
    }

    /* Nav items wrapped in a glass rounded-rect box */
    .sidebar-nav-box {
      background: var(--glass);
      backdrop-filter: var(--glass-blur);
      -webkit-backdrop-filter: var(--glass-blur);
      border: 1px solid var(--glass-border);
      box-shadow: var(--glass-shadow);
      border-radius: 20px;
      padding: 10px 8px;
      display: flex;
      flex-direction: column;
      gap: 2px;
      flex: 1;
      overflow: hidden;
    }

    .nav-item {
      display: flex;
      align-items: center;
      gap: 14px;
      padding: 12px 14px;
      border-radius: 14px;
      font-size: 15px;
      font-weight: 600;
      color: rgba(255,255,255,0.70);
      text-decoration: none;
      cursor: pointer;
      transition: background 0.2s, color 0.2s;
      user-select: none;
    }

    .nav-item:hover {
      background: rgba(255,255,255,0.10);
      color: #fff;
    }

    .nav-item.active {
      background: rgba(255,255,255,0.16);
      color: #fff;
      backdrop-filter: blur(10px);
      -webkit-backdrop-filter: blur(10px);
      border: 1px solid rgba(255,255,255,0.22);
      box-shadow: inset 0 1px 0 rgba(255,255,255,0.25);
    }

    .nav-icon {
      width: 22px;
      height: 22px;
      flex-shrink: 0;
      opacity: 0.85;
    }

    .nav-item.active .nav-icon { opacity: 1; }

    .sidebar-avatar {
      margin-top: auto;
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 12px 10px;
      border-radius: 14px;
      background: rgba(255,255,255,0.08);
      border: 1px solid rgba(255,255,255,0.14);
    }

    .sidebar-avatar img {
      width: 36px;
      height: 36px;
      border-radius: 50%;
      object-fit: cover;
      border: 2px solid rgba(255,255,255,0.3);
    }

    .sidebar-avatar-info { flex: 1; min-width: 0; }
    .sidebar-avatar-name { font-size: 13px; font-weight: 700; }
    .sidebar-avatar-handle { font-size: 11px; color: var(--text-dim); }

    /* ============================================================ */
    /*  SEARCH PANEL — Instagram-style liquid glass slide-over       */
    /* ============================================================ */
    .search-scrim {
      position: fixed;
      inset: 0;
      z-index: 150;
      background: transparent;
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.3s ease;
    }
    .search-scrim.open {
      opacity: 1;
      pointer-events: auto;
    }

    .search-panel {
      position: fixed;
      top: 0;
      left: 0;
      width: 400px;
      max-width: 88vw;
      height: 100vh;
      z-index: 160;
      background: rgba(14,14,22,0.62);
      backdrop-filter: blur(32px) saturate(1.7);
      -webkit-backdrop-filter: blur(32px) saturate(1.7);
      border-right: 1px solid var(--glass-border);
      box-shadow: 12px 0 50px rgba(0,0,0,0.40), inset -1px 0 0 rgba(255,255,255,0.10);
      transform: translateX(-100%);
      transition: transform 0.4s cubic-bezier(.22,1,.36,1);
      display: flex;
      flex-direction: column;
      padding: 30px 22px 18px;
    }
    .search-panel.open {
      transform: translateX(0);
    }

    .search-panel-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 24px;
      flex-shrink: 0;
    }
    .search-panel-title {
      font-size: 26px;
      font-weight: 800;
      letter-spacing: -0.5px;
    }
    .search-panel-close {
      width: 36px;
      height: 36px;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      background: rgba(255,255,255,0.08);
      border: 1px solid rgba(255,255,255,0.14);
      cursor: pointer;
      transition: background 0.2s, transform 0.15s;
      color: #fff;
    }
    .search-panel-close:hover { background: rgba(255,255,255,0.18); transform: scale(1.05); }
    .search-panel-close svg { width: 16px; height: 16px; }

    .search-input-wrap {
      position: relative;
      display: flex;
      align-items: center;
      background: var(--liquid-bg);
      border: 1px solid var(--liquid-border);
      box-shadow: var(--liquid-shadow);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      border-radius: 14px;
      padding: 0 14px;
      margin-bottom: 22px;
      height: 46px;
      flex-shrink: 0;
    }
    .search-input-wrap svg.search-icon { width: 18px; height: 18px; opacity: 0.6; flex-shrink: 0; color: #fff; }
    .search-panel-input {
      flex: 1;
      background: none;
      border: none;
      outline: none;
      color: #fff;
      font-family: 'Outfit', sans-serif;
      font-size: 15px;
      font-weight: 500;
      padding: 0 10px;
    }
    .search-panel-input::placeholder { color: rgba(255,255,255,0.45); }
    .search-input-clear {
      width: 20px;
      height: 20px;
      border-radius: 50%;
      background: rgba(255,255,255,0.25);
      align-items: center;
      justify-content: center;
      cursor: pointer;
      flex-shrink: 0;
      display: none;
      color: #fff;
    }
    .search-input-clear.show { display: flex; }
    .search-input-clear svg { width: 11px; height: 11px; }

    .search-panel-subheader {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 8px;
      padding: 0 4px;
      flex-shrink: 0;
    }
    .search-panel-subheader .label { font-size: 16px; font-weight: 700; }
    .search-panel-clear-all {
      font-size: 13px;
      font-weight: 600;
      color: var(--accent);
      cursor: pointer;
      background: none;
      border: none;
      font-family: 'Outfit', sans-serif;
    }
    .search-panel-clear-all:hover { text-decoration: underline; }

    .search-panel-list {
      flex: 1;
      overflow-y: auto;
      display: flex;
      flex-direction: column;
      gap: 2px;
      margin: 0 -10px;
      padding: 0 10px;
    }
    .search-panel-list::-webkit-scrollbar { width: 6px; }
    .search-panel-list::-webkit-scrollbar-thumb { background: rgba(255,255,255,0.15); border-radius: 10px; }

    .search-result-item {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 8px 6px;
      border-radius: 12px;
      cursor: pointer;
      transition: background 0.15s;
    }
    .search-result-item:hover { background: rgba(255,255,255,0.08); }
    .search-result-item.hidden { display: none; }

    .search-result-avatar {
      width: 44px;
      height: 44px;
      border-radius: 50%;
      object-fit: cover;
      flex-shrink: 0;
      border: 1px solid rgba(255,255,255,0.15);
    }
    .search-result-avatar-fallback {
      width: 44px;
      height: 44px;
      border-radius: 50%;
      flex-shrink: 0;
      display: flex;
      align-items: center;
      justify-content: center;
      background: rgba(255,255,255,0.10);
      border: 1px solid rgba(255,255,255,0.15);
    }
    .search-result-avatar-fallback svg { width: 20px; height: 20px; opacity: 0.65; color: #fff; }

    .search-result-avatar-game {
      width: 44px;
      height: 44px;
      border-radius: 12px;
      object-fit: cover;
      flex-shrink: 0;
      border: 1px solid rgba(255,255,255,0.15);
    }

    .search-result-info { flex: 1; min-width: 0; }
    .search-result-name {
      font-size: 14px;
      font-weight: 700;
      display: flex;
      align-items: center;
      gap: 4px;
      color: #fff;
    }
    .search-result-name svg.verified-badge { width: 14px; height: 14px; flex-shrink: 0; }
    .search-result-sub {
      font-size: 12.5px;
      color: var(--text-dim);
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }
    .search-result-tag {
      font-size: 10.5px;
      font-weight: 700;
      letter-spacing: 0.4px;
      text-transform: uppercase;
      color: var(--accent);
      background: rgba(126,184,255,0.15);
      border: 1px solid rgba(126,184,255,0.30);
      padding: 2px 7px;
      border-radius: 6px;
      flex-shrink: 0;
    }

    .search-result-remove {
      width: 26px;
      height: 26px;
      border-radius: 50%;
      flex-shrink: 0;
      display: flex;
      align-items: center;
      justify-content: center;
      background: none;
      border: none;
      cursor: pointer;
      opacity: 0.6;
      color: #fff;
    }
    .search-result-remove:hover { opacity: 1; background: rgba(255,255,255,0.1); }
    .search-result-remove svg { width: 14px; height: 14px; }

    .search-panel-empty {
      text-align: center;
      color: var(--text-dim);
      font-size: 14px;
      padding: 40px 10px;
      display: none;
    }
    .search-panel-empty.show { display: block; }


    /* Right panel top icons */
    .right-topbar {
      display: flex;
      justify-content: flex-end;
      gap: 10px;
      margin-bottom: 4px;
    }

    .top-icon-btn {
      width: 40px;
      height: 40px;
      border-radius: 50%;
      border: 1px solid var(--glass-border);
      background: var(--glass);
      backdrop-filter: blur(14px);
      -webkit-backdrop-filter: blur(14px);
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      color: var(--text-dim);
      position: relative;
      transition: background 0.2s;
    }

    .top-icon-btn:hover { background: rgba(255,255,255,0.22); color: #fff; }
    .top-icon-btn svg { width: 18px; height: 18px; }

    .badge-dot { display: none; } /* replaced by notif-count-badge */

    /* ============================================================ */
    /*  AI FLOATING BUTTON & CHAT                                    */
    /* ============================================================ */
    .ai-fab-wrap {
      position: fixed;
      bottom: 28px;
      right: 28px;
      z-index: 9999;
      display: flex;
      flex-direction: column;
      align-items: flex-end;
      gap: 10px;
    }

    .ai-welcome-bubble {
      background: var(--liquid-bg);
      backdrop-filter: var(--glass-blur);
      -webkit-backdrop-filter: var(--glass-blur);
      border: 1px solid var(--liquid-border);
      box-shadow: var(--liquid-shadow);
      border-radius: 18px 18px 4px 18px;
      padding: 10px 16px;
      font-size: 13px;
      font-weight: 600;
      color: #fff;
      max-width: 200px;
      opacity: 0;
      transform: translateY(8px) scale(0.95);
      transition: opacity 0.4s ease, transform 0.4s ease;
      pointer-events: none;
    }

    .ai-welcome-bubble.show {
      opacity: 1;
      transform: translateY(0) scale(1);
    }

    /* AI Chat Panel */
    .ai-chat-panel {
      background: rgba(15,15,25,0.85);
      backdrop-filter: blur(30px) saturate(1.8);
      -webkit-backdrop-filter: blur(30px) saturate(1.8);
      border: 1px solid rgba(255,255,255,0.22);
      box-shadow: 0 12px 50px rgba(0,0,0,0.45), inset 0 1px 0 rgba(255,255,255,0.18);
      border-radius: 22px;
      width: 300px;
      display: none;
      flex-direction: column;
      overflow: hidden;
      transform-origin: bottom right;
      animation: panelIn 0.3s cubic-bezier(0.17,0.89,0.32,1.28) forwards;
    }

    .ai-chat-panel.open {
      display: flex;
    }

    @keyframes panelIn {
      from { opacity:0; transform: scale(0.85); }
      to   { opacity:1; transform: scale(1); }
    }

    .ai-chat-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 14px 16px 12px;
      border-bottom: 1px solid rgba(255,255,255,0.10);
    }

    .ai-chat-title {
      display: flex;
      align-items: center;
      gap: 8px;
      font-size: 14px;
      font-weight: 800;
    }

    .ai-avatar-small {
      width: 28px; height: 28px;
      border-radius: 50%;
      background: linear-gradient(135deg, #7c3aed, #3b82f6);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 13px;
    }

    .ai-close-btn {
      background: none;
      border: none;
      color: var(--text-dim);
      cursor: pointer;
      font-size: 14px;
      line-height: 1;
      padding: 4px;
      border-radius: 6px;
      transition: background 0.2s;
    }

    .ai-close-btn:hover { background: rgba(255,255,255,0.1); color: #fff; }

    .ai-chat-messages {
      padding: 12px 12px;
      display: flex;
      flex-direction: column;
      gap: 8px;
      max-height: 240px;
      overflow-y: auto;
      scrollbar-width: none;
    }

    .ai-chat-messages::-webkit-scrollbar { display: none; }

    .ai-msg {
      max-width: 88%;
      padding: 8px 12px;
      border-radius: 14px;
      font-size: 13px;
      line-height: 1.45;
      word-break: break-word;
    }

    .ai-msg-bot {
      background: rgba(255,255,255,0.1);
      border: 1px solid rgba(255,255,255,0.14);
      align-self: flex-start;
      border-radius: 4px 14px 14px 14px;
      color: #fff;
    }

    .ai-msg-user {
      background: linear-gradient(135deg, #7c3aed, #3b82f6);
      align-self: flex-end;
      border-radius: 14px 14px 4px 14px;
      color: #fff;
    }

    .ai-typing {
      display: flex;
      gap: 4px;
      align-items: center;
      padding: 10px 14px;
    }

    .ai-typing span {
      width: 6px; height: 6px;
      border-radius: 50%;
      background: rgba(255,255,255,0.5);
      animation: typingDot 1.2s infinite;
    }

    .ai-typing span:nth-child(2) { animation-delay: 0.2s; }
    .ai-typing span:nth-child(3) { animation-delay: 0.4s; }

    @keyframes typingDot {
      0%,60%,100% { transform: translateY(0); opacity: 0.4; }
      30% { transform: translateY(-5px); opacity: 1; }
    }

    .ai-chat-input-wrap {
      display: flex;
      align-items: center;
      gap: 8px;
      padding: 10px 12px;
      border-top: 1px solid rgba(255,255,255,0.10);
    }

    .ai-chat-input {
      flex: 1;
      background: rgba(255,255,255,0.08);
      border: 1px solid rgba(255,255,255,0.15);
      border-radius: 20px;
      padding: 8px 14px;
      color: #fff;
      font-size: 13px;
      font-family: 'Outfit', sans-serif;
      outline: none;
      transition: border-color 0.2s;
    }

    .ai-chat-input::placeholder { color: rgba(255,255,255,0.4); }
    .ai-chat-input:focus { border-color: rgba(255,255,255,0.35); }

    .ai-send-btn {
      width: 34px; height: 34px;
      border-radius: 50%;
      background: linear-gradient(135deg, #7c3aed, #3b82f6);
      border: none;
      color: #fff;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
      transition: opacity 0.2s, transform 0.15s;
    }

    .ai-send-btn:hover { opacity: 0.85; transform: scale(1.05); }
    .ai-send-btn svg { width: 15px; height: 15px; }

    /* FAB button */
    .ai-fab {
      width: 54px; height: 54px;
      border-radius: 50%;
      background: rgba(255,255,255,0.14);
      backdrop-filter: blur(16px) saturate(1.6);
      -webkit-backdrop-filter: blur(16px) saturate(1.6);
      border: 1.5px solid rgba(255,255,255,0.42);
      box-shadow: 0 6px 24px rgba(100,60,255,0.30), inset 0 2px 6px rgba(255,255,255,0.50), inset 0 -2px 4px rgba(0,0,0,0.12);
      cursor: pointer;
      position: relative;
      overflow: hidden;
      padding: 0;
      transition: transform 0.2s, box-shadow 0.2s;
    }

    .ai-fab:hover { transform: scale(1.07); box-shadow: 0 8px 32px rgba(100,60,255,0.45), inset 0 2px 6px rgba(255,255,255,0.55); }

    .ai-fab-avatar {
      width: 100%; height: 100%;
      border-radius: 50%;
      overflow: hidden;
      position: relative;
    }

    .ai-fab-avatar img {
      width: 100%; height: 100%;
      object-fit: cover;
      border-radius: 50%;
    }

    .ai-fab-glow {
      position: absolute;
      inset: 0;
      border-radius: 50%;
      background: linear-gradient(135deg, rgba(150,100,255,0.35) 0%, transparent 60%);
      pointer-events: none;
    }


    /* ============================================================ */
    /*  MESSAGES POPUP SYSTEM                                        */
    /* ============================================================ */

    /* Shared popup base */
    .msg-inbox-popup,
    .msg-chat-popup {
      position: fixed;
      top: 70px;
      right: 28px;
      width: 340px;
      border-radius: 22px;
      background: rgba(12,14,28,0.82);
      backdrop-filter: blur(32px) saturate(1.8);
      -webkit-backdrop-filter: blur(32px) saturate(1.8);
      border: 1px solid rgba(255,255,255,0.18);
      box-shadow: 0 16px 60px rgba(0,0,0,0.5), inset 0 1px 0 rgba(255,255,255,0.16), inset 0 0 0 1px rgba(255,255,255,0.06);
      z-index: 3000;
      display: none;
      flex-direction: column;
      overflow: hidden;
      animation: msgPopupIn 0.28s cubic-bezier(0.17,0.89,0.32,1.28) forwards;
    }

    .msg-inbox-popup.open,
    .msg-chat-popup.open { display: flex; }

    @keyframes msgPopupIn {
      from { opacity:0; transform: scale(0.88) translateY(-10px); }
      to   { opacity:1; transform: scale(1) translateY(0); }
    }

    /* Inbox header */
    .msg-inbox-header {
      display: flex;
      align-items: center;
      gap: 8px;
      padding: 16px 16px 12px;
      border-bottom: 1px solid rgba(255,255,255,0.09);
      flex-shrink: 0;
    }

    .msg-inbox-title {
      font-size: 16px;
      font-weight: 800;
      color: #fff;
    }

    .msg-inbox-badge {
      background: #ef4444;
      color: #fff;
      font-size: 10px;
      font-weight: 800;
      border-radius: 20px;
      padding: 1px 6px;
      min-width: 18px;
      text-align: center;
    }

    .msg-inbox-expand,
    .msg-inbox-close {
      background: none;
      border: none;
      color: rgba(255,255,255,0.5);
      cursor: pointer;
      padding: 4px;
      border-radius: 8px;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: background 0.15s, color 0.15s;
    }

    .msg-inbox-expand:hover,
    .msg-inbox-close:hover { background: rgba(255,255,255,0.10); color: #fff; }

    /* Inbox list */
    .msg-inbox-list {
      overflow-y: auto;
      max-height: 420px;
      padding: 6px 0 8px;
      scrollbar-width: none;
    }

    .msg-inbox-list::-webkit-scrollbar { display: none; }

    .msg-conv-item {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 10px 16px;
      cursor: pointer;
      transition: background 0.15s;
      position: relative;
    }

    .msg-conv-item:hover { background: rgba(255,255,255,0.07); }

    .msg-conv-avatar-wrap {
      position: relative;
      flex-shrink: 0;
    }

    .msg-conv-avatar {
      width: 46px;
      height: 46px;
      border-radius: 50%;
      object-fit: cover;
      border: 2px solid rgba(255,255,255,0.15);
    }

    .msg-conv-online-dot {
      position: absolute;
      bottom: 2px; right: 2px;
      width: 11px; height: 11px;
      border-radius: 50%;
      background: #22c55e;
      border: 2px solid #0c0e1c;
    }

    .msg-conv-info { flex: 1; min-width: 0; }
    .msg-conv-name { font-size: 14px; font-weight: 700; color: #fff; }
    .msg-conv-preview {
      font-size: 12px;
      color: rgba(255,255,255,0.5);
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
      max-width: 170px;
    }

    .msg-conv-meta {
      display: flex;
      flex-direction: column;
      align-items: flex-end;
      gap: 4px;
      flex-shrink: 0;
    }

    .msg-conv-time { font-size: 11px; color: rgba(255,255,255,0.4); }

    .msg-conv-unread-dot {
      width: 9px; height: 9px;
      border-radius: 50%;
      background: #3b82f6;
    }

    /* ---- CHAT POPUP ---- */
    .msg-chat-popup {
      height: 520px;
      top: 70px;
    }

    .msg-chat-header {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 12px 14px;
      border-bottom: 1px solid rgba(255,255,255,0.09);
      flex-shrink: 0;
    }

    .msg-chat-back {
      background: none;
      border: none;
      color: rgba(255,255,255,0.6);
      cursor: pointer;
      padding: 4px;
      border-radius: 8px;
      display: flex;
      align-items: center;
      transition: background 0.15s, color 0.15s;
    }

    .msg-chat-back:hover { background: rgba(255,255,255,0.10); color: #fff; }

    .msg-chat-user-info {
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .msg-chat-avatar {
      width: 36px; height: 36px;
      border-radius: 50%;
      object-fit: cover;
      border: 2px solid rgba(255,255,255,0.2);
    }

    .msg-chat-name { font-size: 14px; font-weight: 700; color: #fff; }
    .msg-chat-status { font-size: 11px; color: #22c55e; }

    /* Chat messages scrollable area */
    .msg-chat-messages {
      flex: 1;
      overflow-y: auto;
      padding: 14px 12px 8px;
      display: flex;
      flex-direction: column;
      gap: 6px;
      scrollbar-width: thin;
      scrollbar-color: rgba(255,255,255,0.12) transparent;
    }

    .msg-chat-messages::-webkit-scrollbar { width: 3px; }
    .msg-chat-messages::-webkit-scrollbar-thumb { background: rgba(255,255,255,0.12); border-radius: 10px; }

    /* Individual message bubble */
    .msg-bubble-wrap {
      display: flex;
      flex-direction: column;
      position: relative;
    }

    .msg-bubble-wrap.mine { align-items: flex-end; }
    .msg-bubble-wrap.theirs { align-items: flex-start; }

    .msg-bubble {
      max-width: 75%;
      padding: 9px 13px;
      border-radius: 18px;
      font-size: 13px;
      line-height: 1.45;
      position: relative;
      word-break: break-word;
      cursor: pointer;
    }

    .msg-bubble-wrap.mine .msg-bubble {
      background: linear-gradient(135deg, #3b5bdb, #2563eb);
      color: #fff;
      border-bottom-right-radius: 5px;
    }

    .msg-bubble-wrap.theirs .msg-bubble {
      background: rgba(255,255,255,0.12);
      border: 1px solid rgba(255,255,255,0.10);
      color: #fff;
      border-bottom-left-radius: 5px;
    }

    /* Voice message bubble */
    .msg-voice-bubble {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 10px 14px;
      min-width: 160px;
    }

    .msg-voice-play-btn {
      width: 30px; height: 30px;
      border-radius: 50%;
      background: rgba(255,255,255,0.2);
      border: none;
      color: #fff;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
      transition: background 0.15s;
    }

    .msg-voice-play-btn:hover { background: rgba(255,255,255,0.32); }

    .msg-voice-waveform {
      flex: 1;
      height: 26px;
      display: flex;
      align-items: center;
      gap: 2px;
    }

    .msg-voice-bar {
      width: 3px;
      border-radius: 2px;
      background: rgba(255,255,255,0.6);
      flex-shrink: 0;
    }

    .msg-voice-dur {
      font-size: 11px;
      color: rgba(255,255,255,0.65);
      flex-shrink: 0;
    }

    /* Image message */
    .msg-image-msg {
      max-width: 200px;
      border-radius: 14px;
      overflow: hidden;
      cursor: pointer;
    }

    .msg-image-msg img {
      width: 100%;
      display: block;
      border-radius: 14px;
    }

    /* Sticker message */
    .msg-sticker-msg {
      font-size: 42px;
      padding: 4px 8px;
      background: none !important;
      border: none !important;
      box-shadow: none !important;
    }

    /* Reaction on message */
    .msg-reaction-wrap {
      display: flex;
      margin-top: 2px;
    }

    .msg-bubble-wrap.mine .msg-reaction-wrap { justify-content: flex-end; }

    .msg-reaction-badge {
      background: rgba(255,255,255,0.14);
      backdrop-filter: blur(8px);
      border: 1px solid rgba(255,255,255,0.18);
      border-radius: 20px;
      padding: 2px 7px;
      font-size: 13px;
      cursor: pointer;
    }

    /* Reply reference inside bubble */
    .msg-reply-ref {
      background: rgba(255,255,255,0.12);
      border-left: 2px solid rgba(255,255,255,0.5);
      border-radius: 8px 8px 0 0;
      padding: 5px 9px;
      font-size: 11px;
      color: rgba(255,255,255,0.65);
      margin-bottom: 4px;
      max-width: 75%;
    }

    .msg-bubble-wrap.mine .msg-reply-ref {
      align-self: flex-end;
      border-left-color: rgba(255,255,255,0.7);
    }

    /* Hover action icons (react + reply) */
    .msg-bubble-actions {
      display: none;
      position: absolute;
      top: 50%;
      transform: translateY(-50%);
      gap: 4px;
      align-items: center;
    }

    .msg-bubble-wrap.theirs .msg-bubble-actions { right: -64px; }
    .msg-bubble-wrap.mine .msg-bubble-actions { left: -64px; }

    .msg-bubble-wrap:hover .msg-bubble-actions { display: flex; }

    .msg-action-icon {
      width: 28px; height: 28px;
      border-radius: 50%;
      background: rgba(255,255,255,0.12);
      backdrop-filter: blur(8px);
      border: 1px solid rgba(255,255,255,0.16);
      color: rgba(255,255,255,0.8);
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: background 0.15s;
    }

    .msg-action-icon:hover { background: rgba(255,255,255,0.22); color: #fff; }

    /* Reply bar */
    .msg-reply-bar {
      display: flex;
      align-items: center;
      gap: 8px;
      padding: 8px 14px;
      background: rgba(255,255,255,0.06);
      border-top: 1px solid rgba(255,255,255,0.08);
      flex-shrink: 0;
    }

    .msg-reply-bar-inner { flex: 1; min-width: 0; }
    .msg-reply-label { font-size: 10px; color: rgba(255,255,255,0.5); display: block; }
    .msg-reply-preview { font-size: 12px; color: rgba(255,255,255,0.8); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; display: block; max-width: 230px; }

    .msg-reply-cancel-btn {
      background: none;
      border: none;
      color: rgba(255,255,255,0.5);
      cursor: pointer;
      display: flex;
      align-items: center;
      padding: 3px;
      border-radius: 6px;
    }

    .msg-reply-cancel-btn:hover { background: rgba(255,255,255,0.1); color: #fff; }

    /* Image preview bar */
    .msg-image-preview-bar {
      display: flex;
      gap: 6px;
      padding: 8px 14px;
      border-top: 1px solid rgba(255,255,255,0.08);
      overflow-x: auto;
      scrollbar-width: none;
      flex-shrink: 0;
    }

    .msg-image-preview-bar::-webkit-scrollbar { display: none; }

    .msg-preview-thumb {
      width: 52px; height: 52px;
      border-radius: 10px;
      object-fit: cover;
      flex-shrink: 0;
      border: 1.5px solid rgba(255,255,255,0.2);
    }

    /* Input area */
    .msg-chat-input-area {
      padding: 8px 10px 10px;
      border-top: 1px solid rgba(255,255,255,0.09);
      flex-shrink: 0;
    }

    .msg-normal-input {
      display: flex;
      align-items: center;
      gap: 6px;
      background: rgba(255,255,255,0.08);
      border: 1px solid rgba(255,255,255,0.14);
      border-radius: 26px;
      padding: 6px 10px;
    }

    .msg-chat-text-input {
      flex: 1;
      background: none;
      border: none;
      outline: none;
      color: #fff;
      font-size: 13px;
      font-family: 'Outfit', sans-serif;
      min-width: 0;
    }

    .msg-chat-text-input::placeholder { color: rgba(255,255,255,0.38); }

    .msg-input-action-btn {
      background: none;
      border: none;
      color: rgba(255,255,255,0.55);
      cursor: pointer;
      padding: 3px;
      display: flex;
      align-items: center;
      justify-content: center;
      border-radius: 50%;
      flex-shrink: 0;
      transition: color 0.15s, background 0.15s;
    }

    .msg-input-action-btn:hover { color: #fff; background: rgba(255,255,255,0.1); }
    .msg-send-active { color: #3b82f6 !important; }

    /* Voice record state */
    .msg-voice-rec-state {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 8px 10px;
      background: rgba(239,68,68,0.12);
      border: 1px solid rgba(239,68,68,0.3);
      border-radius: 26px;
    }

    .msg-voice-pulse {
      width: 10px; height: 10px;
      border-radius: 50%;
      background: #ef4444;
      flex-shrink: 0;
      animation: voicePulse 1.2s ease-in-out infinite;
    }

    @keyframes voicePulse {
      0%,100% { opacity:1; transform: scale(1); }
      50% { opacity:0.4; transform: scale(0.7); }
    }

    .msg-rec-timer {
      font-size: 13px;
      font-weight: 700;
      color: #ef4444;
      min-width: 36px;
    }

    .msg-voice-ctrl-btn {
      background: none;
      border: none;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      border-radius: 50%;
      padding: 5px;
      transition: background 0.15s;
    }

    .msg-voice-ctrl-btn { color: rgba(255,255,255,0.7); }
    .msg-voice-ctrl-btn:hover { background: rgba(255,255,255,0.1); color: #fff; }
    .msg-voice-stop { color: #3b82f6 !important; }
    .msg-voice-cancel { color: rgba(255,255,255,0.5) !important; }
    .msg-voice-cancel:hover { color: #ef4444 !important; }

    /* Cancel img btn */
    .msg-cancel-img-btn { color: rgba(255,255,255,0.5) !important; }
    .msg-cancel-img-btn:hover { color: #ef4444 !important; }

    /* Emoji picker */
    .msg-emoji-picker {
      position: fixed;
      background: rgba(18,20,36,0.90);
      backdrop-filter: blur(24px);
      border: 1px solid rgba(255,255,255,0.18);
      border-radius: 40px;
      padding: 8px 12px;
      display: flex;
      gap: 6px;
      z-index: 4000;
      box-shadow: 0 8px 32px rgba(0,0,0,0.4);
      animation: msgPopupIn 0.2s ease forwards;
    }

    .msg-emoji-picker span {
      font-size: 20px;
      cursor: pointer;
      border-radius: 50%;
      padding: 4px;
      transition: transform 0.15s, background 0.15s;
    }

    .msg-emoji-picker span:hover { transform: scale(1.3); background: rgba(255,255,255,0.1); }

    /* Sticker picker */
    .msg-sticker-picker {
      position: fixed;
      background: rgba(18,20,36,0.90);
      backdrop-filter: blur(24px);
      border: 1px solid rgba(255,255,255,0.18);
      border-radius: 20px;
      padding: 12px;
      z-index: 4000;
      box-shadow: 0 8px 32px rgba(0,0,0,0.4);
      animation: msgPopupIn 0.2s ease forwards;
      width: 200px;
    }

    .msg-sticker-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 4px;
    }

    .msg-sticker-item {
      font-size: 26px;
      text-align: center;
      cursor: pointer;
      padding: 6px;
      border-radius: 10px;
      transition: background 0.15s, transform 0.15s;
    }

    .msg-sticker-item:hover { background: rgba(255,255,255,0.12); transform: scale(1.15); }

  
    .post-action-btn.like-btn.liked {
      color: #ef4444;
      animation: none;
    }

    .post-action-btn.like-btn.like-pop {
      animation: likePop 0.35s cubic-bezier(0.17, 0.89, 0.32, 1.28);
    }

    @keyframes likePop {
      0%   { transform: scale(1); }
      50%  { transform: scale(1.5); }
      100% { transform: scale(1); }
    }

    /* ============================================================ */
    /*  NOTIFICATION COUNT BADGE                                     */
    /* ============================================================ */
    .notif-count-badge {
      position: absolute;
      top: -5px; right: -5px;
      min-width: 18px; height: 18px;
      border-radius: 9px;
      background: #ef4444;
      border: 2px solid rgba(0,0,0,0.85);
      color: #fff;
      font-size: 9px;
      font-weight: 800;
      font-family: 'Outfit', sans-serif;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 0 4px;
      line-height: 1;
      z-index: 2;
      pointer-events: none;
    }
    .notif-count-badge.hidden { display: none; }

    /* ============================================================ */
    /*  LIKE NOTIFICATIONS POPUP                                     */
    /* ============================================================ */
    .like-notif-popup {
      position: fixed;
      top: 70px;
      right: 28px;
      width: 340px;
      border-radius: 22px;
      background: rgba(12,14,28,0.82);
      backdrop-filter: blur(32px) saturate(1.8);
      -webkit-backdrop-filter: blur(32px) saturate(1.8);
      border: 1px solid rgba(255,255,255,0.18);
      box-shadow: 0 16px 60px rgba(0,0,0,0.5), inset 0 1px 0 rgba(255,255,255,0.16), inset 0 0 0 1px rgba(255,255,255,0.06);
      z-index: 3000;
      display: none;
      flex-direction: column;
      overflow: hidden;
      max-height: 520px;
      animation: msgPopupIn 0.28s cubic-bezier(0.17,0.89,0.32,1.28) forwards;
    }

    .like-notif-popup.open { display: flex; }

    .like-notif-header {
      display: flex;
      align-items: center;
      gap: 8px;
      padding: 15px 16px 12px;
      border-bottom: 1px solid rgba(255,255,255,0.09);
      flex-shrink: 0;
    }

    .like-notif-title {
      font-size: 15px;
      font-weight: 800;
      color: #fff;
    }

    .like-notif-close {
      background: none;
      border: none;
      color: rgba(255,255,255,0.5);
      cursor: pointer;
      padding: 4px;
      border-radius: 8px;
      display: flex;
      align-items: center;
      transition: background 0.15s;
    }
    .like-notif-close:hover { background: rgba(255,255,255,0.1); color: #fff; }

    .like-notif-scroll {
      overflow-y: auto;
      flex: 1;
      padding: 4px 0 8px;
      scrollbar-width: thin;
      scrollbar-color: rgba(255,255,255,0.15) transparent;
    }

    .like-notif-scroll::-webkit-scrollbar { width: 4px; }
    .like-notif-scroll::-webkit-scrollbar-track { background: transparent; }
    .like-notif-scroll::-webkit-scrollbar-thumb { background: rgba(255,255,255,0.15); border-radius: 4px; }

    .like-notif-section-label {
      font-size: 11px;
      font-weight: 800;
      color: rgba(255,255,255,0.45);
      letter-spacing: 0.5px;
      text-transform: uppercase;
      padding: 10px 16px 4px;
    }

    .like-notif-item {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 9px 14px;
      cursor: pointer;
      transition: background 0.15s;
      position: relative;
    }

    .like-notif-item:hover { background: rgba(255,255,255,0.05); }

    .like-notif-item.unread {
      background: rgba(126,184,255,0.06);
    }
    .like-notif-item.unread:hover { background: rgba(126,184,255,0.1); }

    /* Avatar area */
    .like-notif-avatars {
      flex-shrink: 0;
      position: relative;
      width: 44px;
      height: 36px;
    }

    .lna-img {
      width: 34px; height: 34px;
      border-radius: 50%;
      object-fit: cover;
      border: 2px solid rgba(0,0,0,0.8);
      position: absolute;
    }

    .like-notif-avatars.stacked .lna-back { left: 0; top: 0; width: 28px; height: 28px; opacity: 0.8; }
    .like-notif-avatars.stacked .lna-front { right: 0; bottom: 0; width: 28px; height: 28px; }
    .like-notif-avatars .lna-single { left: 0; top: 1px; }

    /* Text */
    .like-notif-text {
      flex: 1;
      min-width: 0;
      font-size: 12.5px;
      color: rgba(255,255,255,0.75);
      line-height: 1.4;
    }

    .lnt-bold { font-weight: 700; color: #fff; }

    .lnt-time {
      font-size: 10.5px;
      color: rgba(255,255,255,0.38);
      margin-top: 2px;
    }

    .lnt-comment-preview {
      font-size: 11px;
      color: rgba(255,255,255,0.45);
      margin-top: 2px;
      font-style: italic;
    }

    .lnt-actions {
      display: flex;
      gap: 6px;
      margin-top: 5px;
    }

    .lnt-act-btn {
      background: rgba(255,255,255,0.1);
      border: 1px solid rgba(255,255,255,0.15);
      border-radius: 12px;
      color: rgba(255,255,255,0.75);
      font-size: 11px;
      font-weight: 600;
      font-family: 'Outfit', sans-serif;
      padding: 3px 10px;
      cursor: pointer;
      transition: background 0.15s, color 0.15s;
    }

    .lnt-act-btn:hover { background: rgba(255,255,255,0.18); color: #fff; }

    .lnt-act-reply {
      background: rgba(126,184,255,0.15);
      border-color: rgba(126,184,255,0.3);
      color: var(--accent);
    }

    .lnt-act-reply:hover { background: rgba(126,184,255,0.25); }

    /* Follow back button */
    .lnt-follow-back-btn {
      flex-shrink: 0;
      background: rgba(255,255,255,0.15);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      border: 1px solid rgba(255,255,255,0.28);
      border-radius: 14px;
      color: #fff;
      font-size: 11px;
      font-weight: 700;
      font-family: 'Outfit', sans-serif;
      padding: 5px 12px;
      cursor: pointer;
      transition: background 0.2s, color 0.2s;
      white-space: nowrap;
    }

    .lnt-follow-back-btn:hover { background: rgba(255,255,255,0.25); }

    .lnt-follow-back-btn.lnt-followed {
      background: rgba(255,255,255,0.07);
      border-color: rgba(255,255,255,0.14);
      color: rgba(255,255,255,0.45);
      cursor: default;
    }

    /* Post thumbnail on right */
    .like-notif-post-thumb {
      flex-shrink: 0;
      width: 42px;
      height: 42px;
      border-radius: 8px;
      overflow: hidden;
      position: relative;
      border: 1px solid rgba(255,255,255,0.12);
      cursor: pointer;
    }

    .like-notif-post-thumb img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }

    .lnpt-icon {
      position: absolute;
      bottom: 3px; right: 3px;
      width: 16px; height: 16px;
      border-radius: 50%;
      background: rgba(0,0,0,0.65);
      display: flex;
      align-items: center;
      justify-content: center;
      color: #ef4444;
    }

    /* ============================================================ */
    /*  LIQUID GLASS HINT BUBBLE                                     */
    /* ============================================================ */
    .like-hint-bubble {
      position: fixed;
      top: 74px;
      right: 120px;
      background: rgba(10,12,30,0.72);
      backdrop-filter: blur(28px) saturate(1.8);
      -webkit-backdrop-filter: blur(28px) saturate(1.8);
      border: 1px solid rgba(255,255,255,0.22);
