    });

    stickerBtn.addEventListener('click', (e) => {
      e.stopPropagation();
      const rect = stickerBtn.getBoundingClientRect();
      const showing = stickerPicker.style.display === 'block';
      stickerPicker.style.display = showing ? 'none' : 'block';
      stickerPicker.style.bottom  = (window.innerHeight - rect.top + 8) + 'px';
      stickerPicker.style.right   = (window.innerWidth - rect.right + 0) + 'px';
    });

    document.querySelectorAll('.msg-sticker-item').forEach(it => {
      it.addEventListener('click', (e) => {
        e.stopPropagation();
        const conv = conversations.find(c => c.id === currentConvId);
        if (!conv) return;
        const m = { id: ++nextMsgId, mine:true, type:'sticker', sticker:it.dataset.sticker, time:nowTime() };
        conv.messages.push(m); renderOneBubble(m);
        chatMessages.scrollTop = chatMessages.scrollHeight;
        stickerPicker.style.display = 'none';
        conv.preview = it.dataset.sticker;
      });
    });

    micBtn.addEventListener('click', async () => {
      try {
        const stream = await navigator.mediaDevices.getUserMedia({ audio: true });
        startRec(stream);
      } catch { alert('Mikrofon izni reddedildi.'); }
    });

    function startRec(stream) {
      mediaRecorder = new MediaRecorder(stream);
      audioChunks = []; recSeconds = 0; recPaused = false;
      mediaRecorder.ondataavailable = (e) => { if (e.data.size>0) audioChunks.push(e.data); };
      mediaRecorder.start(100);
      normalInput.style.display = 'none';
      voiceRecState.style.display = 'flex';
      recInterval = setInterval(() => {
        if (!recPaused) {
          recSeconds++;
          recTimer.textContent = Math.floor(recSeconds/60)+':'+String(recSeconds%60).padStart(2,'0');
        }
      }, 1000);
    }

    voicePauseBtn.addEventListener('click', () => {
      if (!mediaRecorder) return;
      if (mediaRecorder.state === 'recording') {
        mediaRecorder.pause(); recPaused = true;
        voicePauseIcon.innerHTML = '<polygon points="5 3 19 12 5 21 5 3"/>';
      } else if (mediaRecorder.state === 'paused') {
        mediaRecorder.resume(); recPaused = false;
        voicePauseIcon.innerHTML = '<rect x="6" y="4" width="4" height="16"/><rect x="14" y="4" width="4" height="16"/>';
      }
    });

    voiceStopBtn.addEventListener('click', () => {
      if (!mediaRecorder) return;
      const dur = recTimer.textContent;
      mediaRecorder.onstop = () => {
        const blob = new Blob(audioChunks, { type:'audio/webm' });
        const blobUrl = URL.createObjectURL(blob);
        const conv = conversations.find(c => c.id === currentConvId);
        if (conv) {
          const m = { id:++nextMsgId, mine:true, type:'voice', blobUrl, dur, time:nowTime(), replyTo: replyingTo ? replyingTo.text : null };
          conv.messages.push(m); renderOneBubble(m);
          chatMessages.scrollTop = chatMessages.scrollHeight;
          replyingTo = null; replyBar.style.display = 'none';
          conv.preview = '🎤 Voice message';
        }
      };
      mediaRecorder.stop(); mediaRecorder.stream.getTracks().forEach(t=>t.stop());
      clearInterval(recInterval);
      voiceRecState.style.display = 'none'; normalInput.style.display = 'flex';
      updateInputControls();
    });

    voiceCancelBtn.addEventListener('click', () => {
      if (mediaRecorder && mediaRecorder.state !== 'inactive') {
        mediaRecorder.stop(); mediaRecorder.stream.getTracks().forEach(t=>t.stop());
      }
      clearInterval(recInterval);
      voiceRecState.style.display = 'none'; normalInput.style.display = 'flex';
      recTimer.textContent = '0:00'; updateInputControls();
    });

    function nowTime() { const d=new Date(); return d.getHours()+':'+String(d.getMinutes()).padStart(2,'0'); }

    updateInputControls();
  })();

