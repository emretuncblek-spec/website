        conversations.forEach(c => c.unread = false);
        updateMsgBadge();
      }
    });

    function updateMsgBadge() {
      const badge = document.getElementById('msgUnreadBadge');
      if (!badge) return;
      const n = conversations.filter(c => c.unread).length;
      if (n > 0) {
        badge.textContent = n > 9 ? '9+' : n;
        badge.classList.remove('hidden');
      } else {
        badge.classList.add('hidden');
      }
    }
    updateMsgBadge();

    inboxClose.addEventListener('click', () => inboxPopup.classList.remove('open'));
    chatClose.addEventListener('click',  () => chatPopup.classList.remove('open'));
    chatBack.addEventListener('click', () => {
      chatPopup.classList.remove('open');
      renderInbox();
      inboxPopup.classList.add('open');
    });

    document.addEventListener('click', (e) => {
      if (!inboxPopup.contains(e.target) && !chatPopup.contains(e.target) &&
          !inboxBtn.contains(e.target) && !emojiPicker.contains(e.target) && !stickerPicker.contains(e.target)) {
        closeAll();
      }
      if (!emojiPicker.contains(e.target)) emojiPicker.style.display = 'none';
      if (!stickerPicker.contains(e.target) && e.target !== stickerBtn && !stickerBtn.contains(e.target)) stickerPicker.style.display = 'none';
    });

    function closeAll() {
      inboxPopup.classList.remove('open');
      chatPopup.classList.remove('open');
      emojiPicker.style.display = 'none';
      stickerPicker.style.display = 'none';
    }

    function renderInbox() {
      inboxList.innerHTML = '';
      conversations.forEach(conv => {
        const item = document.createElement('div');
        item.className = 'msg-conv-item';
        item.innerHTML = `
          <div class="msg-conv-avatar-wrap">
            <img class="msg-conv-avatar" src="${conv.avatar}" alt="${conv.name}">
            ${conv.online ? '<span class="msg-conv-online-dot"></span>' : ''}
          </div>
          <div class="msg-conv-info">
            <div class="msg-conv-name">${conv.name}</div>
            <div class="msg-conv-preview">${conv.preview} • ${conv.time}</div>
          </div>
          <div class="msg-conv-meta">
            ${conv.unread ? '<span class="msg-conv-unread-dot"></span>' : ''}
          </div>
        `;
        item.addEventListener('click', () => openChat(conv.id));
        inboxList.appendChild(item);
      });
    }

    function openChat(convId) {
      currentConvId = convId;
      const conv = conversations.find(c => c.id === convId);
      conv.unread = false;
      document.getElementById('msgChatAvatar').src = conv.avatar;
      document.getElementById('msgChatName').textContent = conv.name;
      const statusEl = document.getElementById('msgChatStatus');
      statusEl.textContent = conv.online ? 'Online' : 'Last seen recently';
      statusEl.style.color = conv.online ? '#22c55e' : 'rgba(255,255,255,0.45)';
      renderMessages(conv);
      inboxPopup.classList.remove('open');
      chatPopup.classList.add('open');
      replyingTo = null; pendingImages = [];
      replyBar.style.display = 'none';
      imagePreviewBar.style.display = 'none';
      cancelImgBtn.style.display = 'none';
      chatInput.value = '';
      updateInputControls();
    }

    function renderMessages(conv) {
      chatMessages.innerHTML = '';
      conv.messages.forEach(msg => renderOneBubble(msg));
      chatMessages.scrollTop = chatMessages.scrollHeight;
    }

    function renderOneBubble(msg) {
      const wrap = document.createElement('div');
      wrap.className = 'msg-bubble-wrap ' + (msg.mine ? 'mine' : 'theirs');
      wrap.dataset.msgId = msg.id;
      let html = '';

      if (msg.replyTo) html += `<div class="msg-reply-ref">↩ ${escHtml(msg.replyTo)}</div>`;

      const actionBtns = `<div class="msg-bubble-actions">
        <button class="msg-action-icon msg-react-btn" title="React"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="13" height="13"><circle cx="12" cy="12" r="10"/><path d="M8 14s1.5 2 4 2 4-2 4-2"/><line x1="9" y1="9" x2="9.01" y2="9"/><line x1="15" y1="9" x2="15.01" y2="9"/></svg></button>
        <button class="msg-action-icon msg-reply-btn" title="Reply"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="13" height="13"><polyline points="9 17 4 12 9 7"/><path d="M20 18v-2a4 4 0 0 0-4-4H4"/></svg></button>
      </div>`;

      if (msg.type === 'text') {
        html += `<div class="msg-bubble" style="position:relative;">${escHtml(msg.text)}${actionBtns}</div>`;
      } else if (msg.type === 'voice') {
        html += `<div class="msg-bubble msg-voice-bubble" style="position:relative;">
          <button class="msg-voice-play-btn" data-blob="${msg.blobUrl||''}">
            <svg viewBox="0 0 24 24" fill="currentColor" width="14" height="14"><polygon points="5 3 19 12 5 21 5 3"/></svg>
          </button>
          <div class="msg-voice-waveform">${genWave()}</div>
          <span class="msg-voice-dur">${msg.dur||'0:05'}</span>
          ${actionBtns}
        </div>`;
      } else if (msg.type === 'image') {
        html += `<div class="msg-image-msg" style="position:relative;"><img src="${msg.url}" alt="photo" loading="lazy">
          <div class="msg-bubble-actions" style="top:8px;transform:none;">${actionBtns.match(/<button[\s\S]*?<\/button>/g).join('')}</div>
        </div>`;
      } else if (msg.type === 'sticker') {
        html += `<div class="msg-bubble msg-sticker-msg">${msg.sticker}</div>`;
      }

      wrap.innerHTML = html;

      if (msg.reaction) {
        const rb = document.createElement('div');
        rb.className = 'msg-reaction-wrap';
        rb.innerHTML = `<span class="msg-reaction-badge">${msg.reaction}</span>`;
        wrap.appendChild(rb);
      }

      const reactBtn = wrap.querySelector('.msg-react-btn');
      const repBtn   = wrap.querySelector('.msg-reply-btn');
      if (reactBtn) reactBtn.addEventListener('click', (e) => { e.stopPropagation(); showEmojiPicker(e, msg.id); });
      if (repBtn)   repBtn.addEventListener('click', (e) => { e.stopPropagation(); startReply(msg); });

      const playBtn = wrap.querySelector('.msg-voice-play-btn');
      if (playBtn) playBtn.addEventListener('click', () => { if (playBtn.dataset.blob) { const a = new Audio(playBtn.dataset.blob); a.play().catch(()=>{}); }});

      chatMessages.appendChild(wrap);
    }

    function genWave() {
      let s = '';
      for (let i=0;i<20;i++) { const h=Math.floor(Math.random()*16)+4; s+=`<div class="msg-voice-bar" style="height:${h}px;opacity:${(0.4+Math.random()*0.5).toFixed(2)}"></div>`; }
      return s;
    }

    function escHtml(s) { return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;'); }

    function showEmojiPicker(e, msgId) {
      const rect = e.currentTarget.getBoundingClientRect();
      emojiPicker.style.display = 'flex';
      emojiPicker.style.top  = (rect.top - 54) + 'px';
      emojiPicker.style.left = Math.min(rect.left - 40, window.innerWidth - 250) + 'px';
      emojiPicker.dataset.targetMsgId = msgId;
    }

    document.querySelectorAll('#msgEmojiPicker span').forEach(sp => {
      sp.addEventListener('click', (e) => {
        e.stopPropagation();
        const mid = parseInt(emojiPicker.dataset.targetMsgId);
        const conv = conversations.find(c => c.id === currentConvId);
        if (conv) { const m = conv.messages.find(x => x.id === mid); if (m) { m.reaction = sp.dataset.emoji; renderMessages(conv); }}
        emojiPicker.style.display = 'none';
      });
    });

    function startReply(msg) {
      replyingTo = { id: msg.id, text: msg.type==='text' ? msg.text : msg.type==='voice' ? '🎤 Voice message' : '🖼️ Image' };
      replyText.textContent = replyingTo.text;
      replyBar.style.display = 'flex';
      chatInput.focus();
    }

    replyCancel.addEventListener('click', () => { replyingTo=null; replyBar.style.display='none'; });

    chatInput.addEventListener('input', updateInputControls);

    function updateInputControls() {
      const hasText   = chatInput.value.trim().length > 0;
      const hasImages = pendingImages.length > 0;
      if (hasText || hasImages) {
        msgSendBtn.style.display = 'flex';
        micBtn.style.display     = 'none';
      } else {
        msgSendBtn.style.display = 'none';
        micBtn.style.display     = 'flex';
      }
    }

    msgSendBtn.addEventListener('click', doSend);
    chatInput.addEventListener('keydown', (e) => { if (e.key==='Enter' && !e.shiftKey) { e.preventDefault(); doSend(); }});

    function doSend() {
      const text = chatInput.value.trim();
      const conv = conversations.find(c => c.id === currentConvId);
      if (!conv) return;

      if (pendingImages.length > 0) {
        pendingImages.forEach(img => {
          const m = { id: ++nextMsgId, mine:true, type:'image', url:img.url, time:nowTime(), replyTo: replyingTo ? replyingTo.text : null };
          conv.messages.push(m); renderOneBubble(m);
        });
        pendingImages = []; imagePreviewBar.innerHTML = '';
        imagePreviewBar.style.display = 'none'; cancelImgBtn.style.display = 'none';
      }

      if (text) {
        const m = { id: ++nextMsgId, mine:true, type:'text', text, time:nowTime(), replyTo: replyingTo ? replyingTo.text : null };
        conv.messages.push(m); renderOneBubble(m);
        chatInput.value = '';
        conv.preview = text;
      }

      replyingTo = null; replyBar.style.display = 'none';
      chatMessages.scrollTop = chatMessages.scrollHeight;
      updateInputControls();
    }

    imageBtn.addEventListener('click', () => fileInput.click());
    fileInput.addEventListener('change', () => {
      Array.from(fileInput.files).forEach(f => {
        const url = URL.createObjectURL(f);
        pendingImages.push({ url });
        const img = document.createElement('img');
        img.src = url; img.className = 'msg-preview-thumb';
        imagePreviewBar.appendChild(img);
      });
      if (pendingImages.length) { imagePreviewBar.style.display='flex'; cancelImgBtn.style.display='flex'; updateInputControls(); }
