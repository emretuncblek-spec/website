    .top-icon-btn { color: #2b3445; background: rgba(255,255,255,.7); border-color: rgba(255,255,255,.95);
                    box-shadow: 0 4px 14px rgba(60,90,140,.16); }
    .top-icon-btn:hover { background: #fff; color: #000; }

    /* ---------- Layout ---------- */
    .earth-main { margin-left: var(--sidebar-w); flex: 1; min-width: 0; padding: 0 26px 48px 30px; position: relative; }

    /* ---------- Hero ---------- */
    .hero { position: relative; height: 573px; padding-top: 140px; }
    .hero-left { position: relative; z-index: 2; width: 560px; }
    .logo-wrap { width: 405px; height: 84px; display: flex; align-items: center; }
    .logo-wrap img { width: 100%; height: 100%; object-fit: contain; object-position: left center; display: block; }
    .logo-fallback { font-weight: 900; font-size: 46px; letter-spacing: 2px; line-height: 1; color: #7ed321;
      -webkit-text-stroke: 3px #3a2a12; paint-order: stroke fill; text-shadow: 0 4px 0 #b8611c; }
    .hero h1 { font-size: 17px; font-weight: 700; letter-spacing: .3px; margin-top: 28px; color: var(--ink); }
    .hero .desc { font-size: 14px; line-height: 21px; letter-spacing: .3px; color: var(--slate); margin-top: 12px; width: 440px; }

    .status { display: flex; align-items: center; gap: 18px; margin-top: 24px; font-size: 14px; letter-spacing: .4px; color: #333d4d; }
    .status .dot { width: 10px; height: 10px; border-radius: 50%; background: #7ed957; display: inline-block; margin-right: 8px; box-shadow: 0 0 8px rgba(126,217,87,.7); }
    .status .dot.off { background: #d9534f; box-shadow: 0 0 8px rgba(217,83,79,.6); }
    .status .players { display: inline-flex; align-items: center; gap: 8px; }
    .status svg { width: 18px; height: 18px; }

    .hero-btns { display: flex; gap: 8px; margin-top: 22px; }
    .btn { height: 42px; padding: 0 22px; border-radius: 999px; display: inline-flex; align-items: center; justify-content: center; gap: 9px;
           font-family: inherit; font-size: 14px; font-weight: 500; letter-spacing: .4px; text-decoration: none; cursor: pointer; border: 0;
           transition: transform .15s, box-shadow .2s, background .2s; }
    .btn:hover { transform: translateY(-1px); }
    .btn svg { width: 17px; height: 17px; }
    .btn-dark { background: #3c3d40; color: #fff; box-shadow: 0 8px 20px rgba(30,40,60,.25); }
    .btn-dark:hover { background: #2e2f32; }
    .btn-light { background: rgba(255,255,255,.85); color: var(--ink); }
    .btn-light:hover { background: #fff; }

    .infos { display: flex; align-items: center; margin-top: 28px; }
    .info { padding: 2px 34px 2px 0; }
    .info + .info { padding-left: 30px; border-left: 2px solid #111; }
    .info .lbl { font-size: 11.5px; color: #4b6a8c; letter-spacing: .3px; }
    .info .val { display: flex; align-items: center; gap: 12px; margin-top: 2px; font-size: 13px; font-weight: 700; letter-spacing: .6px; }
    .info.version { display: flex; align-items: center; gap: 10px; }
    .info.version .val { margin-top: 2px; }
    .info.version svg { width: 30px; height: 30px; color: #444; }
    .copy-ic { width: 15px; height: 15px; cursor: pointer; color: #333; background: none; border: 0; padding: 0; display: inline-flex; }
    .copy-ic svg { width: 100%; height: 100%; }
    .copy-ic:hover { color: #000; transform: scale(1.12); }

    /* ---------- Hero visual: rotating voxel Earth ---------- */
    .hero-visual { position: absolute; top: 74px; right: 6px; width: 470px; height: 500px; z-index: 1; pointer-events: none; }
    .scene { width: 100%; height: 100%; perspective: 1500px; display: flex; align-items: center; justify-content: center; }
    .float { transform-style: preserve-3d; animation: bob 6s ease-in-out infinite; }
    @keyframes bob { 0%,100% { transform: translateY(6px); } 50% { transform: translateY(-10px); } }
    .cube { position: relative; width: 280px; height: 280px; transform-style: preserve-3d; animation: spin 40s linear infinite; }
    @keyframes spin { from { transform: rotateX(-24deg) rotateY(0deg); } to { transform: rotateX(-24deg) rotateY(360deg); } }
    .cube .face { position: absolute; inset: 0; width: 280px; height: 280px; image-rendering: pixelated; backface-visibility: hidden; }
    .f-front  { transform: translateZ(140px); }
    .f-back   { transform: rotateY(180deg) translateZ(140px); filter: brightness(.7); }
    .f-right  { transform: rotateY(90deg) translateZ(140px);  filter: brightness(.86); }
    .f-left   { transform: rotateY(-90deg) translateZ(140px); filter: brightness(.78); }
    .f-top    { transform: rotateX(90deg) translateZ(140px);  filter: brightness(1.08); }
    .f-bottom { transform: rotateX(-90deg) translateZ(140px); filter: brightness(.55); }
    .vox { position: absolute; left: 50%; top: 50%; transform-style: preserve-3d; }
    .vox i { position: absolute; inset: 0; display: block; box-shadow: inset 0 0 0 1px rgba(120,150,190,.18); }
    .cube-shadow { position: absolute; left: 50%; bottom: 8px; width: 300px; height: 40px; transform: translateX(-50%);
      background: radial-gradient(closest-side, rgba(30,50,90,.32), transparent); filter: blur(6px); }

    .feature-float { position: absolute; right: 0; top: 360px; width: 234px; z-index: 3; display: flex; gap: 14px; align-items: center;
      padding: 16px 18px 16px 16px; border-radius: 26px; background: rgba(255,255,255,.62); backdrop-filter: blur(16px); -webkit-backdrop-filter: blur(16px);
      box-shadow: 0 10px 30px rgba(60,90,140,.14); border: 1px solid rgba(255,255,255,.8); }
    .ff-ic { width: 42px; height: 42px; border-radius: 12px; background: #fff; display: grid; place-items: center; flex-shrink: 0; }
    .ff-ic svg { width: 26px; height: 26px; }
    .feature-float b { font-size: 13px; letter-spacing: .3px; display: block; }
    .feature-float span { font-size: 12px; line-height: 1.35; color: #333d4d; display: block; margin-top: 3px; }

    /* ---------- Big panel ---------- */
    .big-panel { background: linear-gradient(180deg,rgba(255,255,255,.9),rgba(238,242,248,.85)); border-radius: 34px; padding: 44px 40px 36px;
      box-shadow: 0 20px 60px rgba(70,100,150,.14); }
    .features { display: grid; grid-template-columns: repeat(6,1fr); gap: 8px; }
    .feat .circle { width: 86px; height: 86px; border-radius: 50%; background: #e2e8ef; display: grid; place-items: center; }
    .feat .circle svg { width: 44px; height: 44px; color: #0b0b10; }
    .feat h3 { font-size: 13px; font-weight: 700; letter-spacing: .3px; margin-top: 22px; white-space: nowrap; }
    .feat p { font-size: 11.5px; line-height: 1.45; color: var(--slate); margin-top: 6px; letter-spacing: .2px; max-width: 130px; }

    .two-col { display: grid; grid-template-columns: 1fr 1fr; gap: 46px; margin-top: 40px; align-items: start; }

    .join-card { background: var(--card); border-radius: 26px; padding: 22px 20px 22px; }
    .join-card h2 { font-size: 21px; letter-spacing: .5px; }
    .join-card .sub { font-size: 12px; color: var(--slate); margin-top: 10px; letter-spacing: .3px; }
    .tab { display: inline-block; margin: 16px 0 0 24px; font-size: 15px; font-weight: 700; letter-spacing: .4px; padding-bottom: 3px; border-bottom: 2px solid #111; }
    .steps { margin: 34px 0 0 24px; position: relative; }
    .step { position: relative; padding-left: 50px; min-height: 60px; margin-bottom: 8px; }
    .step::before { content: ''; position: absolute; left: 11px; top: 24px; bottom: -12px; width: 2px; background: #8a9be6; }
    .step:last-child::before { display: none; }
    .step .n { position: absolute; left: 0; top: 0; width: 24px; height: 24px; border-radius: 50%; background: #7d90de; color: #fff; font-size: 13px; font-weight: 700; display: grid; place-items: center; box-shadow: 0 0 0 3px rgba(125,144,222,.25); }
    .step h4 { font-size: 15px; font-weight: 600; letter-spacing: .4px; color: var(--peri); }
    .step p { font-size: 12px; line-height: 1.5; color: var(--slate); margin-top: 3px; max-width: 220px; letter-spacing: .2px; }
    .join-info { display: flex; justify-content: space-between; margin: 12px 24px 0; }
    .join-info .lbl { font-size: 14px; color: #33405a; letter-spacing: .3px; }
    .join-info .val { display: flex; align-items: center; gap: 12px; margin-top: 4px; font-size: 15px; font-weight: 700; letter-spacing: .6px; }
    .join-info .copy-ic { width: 17px; height: 17px; }
    .copy-all { width: calc(100% - 48px); margin: 20px 24px 0; height: 42px; }

    .side-col { display: flex; flex-direction: column; gap: 18px; }
    .updates { background: #fff; border-radius: 26px; padding: 16px; box-shadow: 0 8px 26px rgba(70,100,150,.08); }
    .up-img { position: relative; height: 122px; border-radius: 18px; overflow: hidden; }
    .up-img svg { width: 100%; height: 100%; display: block; }
    .up-badge { position: absolute; left: 10px; top: 8px; padding: 3px 10px; border-radius: 999px; background: rgba(255,255,255,.85); font-size: 11px; letter-spacing: .4px; color: #333d4d; }
    .up-head { display: flex; justify-content: space-between; align-items: baseline; margin: 12px 0 8px; }
    .up-head h2 { font-size: 19px; letter-spacing: .4px; }
    .up-head a { font-size: 11.5px; color: #46556b; text-decoration: none; letter-spacing: .3px; }
    .up-head a:hover { text-decoration: underline; }
    .up-item { display: flex; align-items: center; gap: 14px; padding: 5px 0; }
    .thumb { width: 70px; height: 37px; border-radius: 9px; flex-shrink: 0;
      background: linear-gradient(180deg,#1a2540 0%,#2b3c63 55%,#d99a55 100%); position: relative; overflow: hidden; }
    .thumb::after { content: ''; position: absolute; inset: 0;
      background:
        linear-gradient(#0d1424,#0d1424) 8% 100%/12% 62% no-repeat,
        linear-gradient(#152036,#152036) 26% 100%/14% 82% no-repeat,
        linear-gradient(#0d1424,#0d1424) 46% 100%/12% 55% no-repeat,
        linear-gradient(#152036,#152036) 62% 100%/16% 92% no-repeat,
        linear-gradient(#0d1424,#0d1424) 84% 100%/14% 66% no-repeat; }
    .up-item b { display: block; font-size: 15px; letter-spacing: .4px; }
    .up-item span { display: block; font-size: 12px; color: var(--slate); margin-top: 3px; letter-spacing: .3px; }

    .discord { display: flex; align-items: center; gap: 16px; background: var(--card); border-radius: 26px; padding: 16px 22px 16px 16px; text-decoration: none; color: inherit;
      transition: transform .2s, box-shadow .2s; }
    .discord:hover { transform: translateY(-2px); box-shadow: 0 10px 26px rgba(70,100,150,.16); }
    .dc-ic { width: 66px; height: 66px; border-radius: 18px; background: #a9b9f7; display: grid; place-items: center; flex-shrink: 0; }
    .dc-ic svg { width: 40px; height: 40px; }
    .discord h3 { font-size: 17px; letter-spacing: .5px; }
    .discord p { font-size: 12px; line-height: 1.5; color: var(--slate); margin-top: 6px; max-width: 200px; letter-spacing: .2px; }
    .discord .arrow { margin-left: auto; width: 30px; height: 30px; color: #2a2a2a; flex-shrink: 0; }

    /* AI balonu: sadece yazı rengi açık zemine göre koyulaştırıldı (AI kodu aynen) */
    .ai-welcome-bubble { color: #1b2333; }

    .copy-toast { position: fixed; left: 50%; bottom: 34px; transform: translate(-50%, 20px); opacity: 0; pointer-events: none;
      background: rgba(20,24,34,.9); color: #fff; padding: 10px 18px; border-radius: 999px; font-size: 13px; letter-spacing: .3px; z-index: 3500; transition: .3s; }
    .copy-toast.show { opacity: 1; transform: translate(-50%, 0); }

    @media (max-width: 1100px) {
      .hero { height: auto; padding-bottom: 30px; }
      .hero-visual { position: relative; top: 0; right: 0; width: 100%; height: 420px; margin-top: 10px; }
      .feature-float { position: relative; top: 0; margin: 10px auto 30px; }
      .features { grid-template-columns: repeat(3,1fr); row-gap: 28px; }
      .two-col { grid-template-columns: 1fr; }
      .hero-left { width: 100%; }
    }

  </style>
</head>
