      --slate: #46556b;
      --peri: #7f93e3;
      --panel: rgba(255,255,255,.72);
      --card: #e3e9f2;
    }
    body {
      background: linear-gradient(100deg,#eef2f7 0%,#dde5f0 38%,#b7c7dd 72%,#a4b9d4 100%) fixed;
